# Agent Server Configuration
AGENT_HOST=0.0.0.0
AGENT_PORT=5002
#AGENT_SSL_KEYFILE=/path_to/ssl_key.pem
#AGENT_SSL_CERTFILE=/path_to/ssl_cert.pem

# Python Logging
PYTHON_LOG_LEVEL=INFO

USE_INMEMORY_SAVER=true

# PostgreSQL credentials for agentic memory (used when USE_INMEMORY_SAVER=false)
POSTGRES_USER=psap_user
POSTGRES_PASSWORD=
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=psap

# Langfuse observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Google Gemini Configuration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Anthropic Claude via Vertex AI (optional — requires GCP auth)
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
CLOUD_ML_REGION=your-gcp-region

# Self-Improvement Features
ENABLE_LLM_JUDGE=true
LLM_JUDGE_MODEL=gemini-3-flash-preview
ENABLE_REFLECTION=true
MAX_REFLECTION_ITERATIONS=2
ENABLE_SKILL_DOCUMENTS=true
SKILL_GENERATION_THRESHOLD=5

# Mem0 Memory (optional — uses Gemini for fact extraction, no extra API key needed)
# Set to true to enable cross-session memory. Uses your existing Google API key.
ENABLE_MEM0=true
