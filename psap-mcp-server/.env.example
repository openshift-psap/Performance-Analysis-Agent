# MCP Server Configuration
MCP_HOST=localhost
MCP_PORT=5001
MCP_TRANSPORT_PROTOCOL=http
# MCP_SSL_KEYFILE=/path/to/ssl_key.pem
# MCP_SSL_CERTFILE=/path/to/ssl_cert.pem

ENABLE_AUTH=False
USE_EXTERNAL_BROWSER_AUTH=False

# Set this to True if you need to plug it into cursor
COMPATIBLE_WITH_CURSOR=True

# Dashboard URL used by generate_dashboard_url. Leave empty when no dashboard is available.
DASHBOARD_BASE_URL=

# Python Logging
PYTHON_LOG_LEVEL=INFO

# This is required only if ENABLE_AUTH is True
SSO_CLIENT_ID=sso_client_id
SSO_CLIENT_SECRET=sso_client_secret
SSO_ISSUER_HOST=sso_issuer_host
SSO_CALLBACK_URL=http://localhost:8080/auth/callback/oidc

#  This is required only if ENABLE_AUTH is True
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=psap
POSTGRES_USER=psap_user
POSTGRES_PASSWORD=

# Grafana API Configuration (for querying metrics)
GRAFANA_URL=https://your-grafana-instance.example.com
# Get API token from: Grafana → Settings → Service Accounts → Add service account token
GRAFANA_API_TOKEN=
GRAFANA_DATASOURCE_UID=

# Configure the downstream GitHub repository as owner/repository.
RHAIIS_DOWNSTREAM_VLLM_REPO=
# GitHub token (needed for private downstream source access;
# also raises API rate limits for public vLLM release/PR lookups).
# Grant Contents: read access to the configured repository and approve for its org if required.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# S3 data sources. Benchmark data/profiles and vLLM logs may use separate buckets.
S3_BUCKET=psap-dashboard-data
S3_REGION=us-east-1
LOG_S3_BUCKET=psap-dashboard-data
LOG_S3_PREFIX=logs

# RHAIIS-to-vLLM mappings are fetched from this public repository and cached for 5 minutes.
# The bundled version_mappings.json remains the fallback if GitHub is unavailable.
RHAIIS_VERSION_MAPPINGS_URL=https://raw.githubusercontent.com/openshift-psap/AI-Analysis-Agent/master/psap-mcp-server/psap_mcp_server/src/tools/version_mappings.json
RHAIIS_VERSION_MAPPINGS_CACHE_TTL_SECONDS=300
