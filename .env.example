# =============================================================================
# Local Container Testing - Infrastructure Credentials
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is sourced by test-local-containers.sh
# The .env file is gitignored and should NEVER be committed.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=

# --- Langfuse v3 Infrastructure ---
LF_CLICKHOUSE_USER=clickhouse
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_AUTH=
LF_MINIO_USER=minio
LF_MINIO_PASSWORD=

# Langfuse auth secrets (auto-generated on first run if left empty)
# To keep sessions stable across container restarts, generate once and paste here:
#   openssl rand -base64 32   (for NEXTAUTH_SECRET and SALT)
#   openssl rand -hex 32      (for ENCRYPTION_KEY)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# --- PyTorch Profile S3 Prefix ---
# Where profile traces live inside the S3_BUCKET (<accel>/<model>/<tp>/<version>/<workload>/trace_*.json)
# The agent discovers models, TP configs, versions, and workloads automatically by listing this prefix.
PROFILE_S3_PREFIX=pytorch-profiles/rhaiis

# --- Dashboard URLs ---
# Set these in .env for local dashboard links. Do not commit internal URLs.
DASHBOARD_BASE_URL=
DASHBOARD_BASE_URL_STAGING=
